# ==============================================================
# LINKEDIN AUTOPILOT - ENVIRONMENT CONFIGURATION
# BY GT INNOX LLP
# ==============================================================

# NEXT.JS & APP URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# SUPABASE CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LINKEDIN DEVELOPER APP CREDENTIALS
# Obtain from https://developer.linkedin.com/
# Products needed: 'Share on LinkedIn' (w_member_social), 'Sign In with LinkedIn using OpenID Connect' (openid, profile, email)
# If organization posting: 'Community Management API' or organization permissions (w_organization_social)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
LINKEDIN_API_VERSION=202401

# GOOGLE GEMINI AI
# Obtain API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# REDIS (FOR BULLMQ BACKGROUND WORKER & JOB SCHEDULER)
# Use local Redis (redis://localhost:6379) or Upstash Redis URL (rediss://default:token@host:port)
REDIS_URL=redis://localhost:6379

# TOKEN ENCRYPTION KEY (32-byte hex or string for AES-256 encryption of LinkedIn tokens)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# BILLING / SUBSCRIPTIONS (Optional for MVP; ready for Stripe / LemonSqueezy)
BILLING_PROVIDER_SECRET=
BILLING_WEBHOOK_SECRET=

